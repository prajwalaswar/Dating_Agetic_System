# ---- Pick ONE free provider and paste its key ----

# Option A — Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Option B — Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

PORT=3000

# Optional — reliable Instagram scraping.
# Instagram blocks anonymous API access; paste the "sessionid" cookie from a
# logged-in Instagram browser session (DevTools → Application → Cookies).
IG_SESSIONID=
